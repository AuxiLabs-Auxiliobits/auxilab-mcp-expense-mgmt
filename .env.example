# Root environment template for local development.
# Each package also has its own .env.example with the full list; this is the common subset.
# In Azure, all of these are projected from Key Vault via Managed Identity — never committed.

# ---- API (prefix APP_) ----
APP_ENVIRONMENT=dev
APP_AUTH_PROVIDER=db
APP_JWT_SECRET=dev-only-change-me
APP_DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense
APP_SEED_DEMO_DATA=true

# ---- Workers (prefix WORKERS_) ----
WORKERS_SERVICEBUS_NAMESPACE=
WORKERS_SEARCH_ENDPOINT=
WORKERS_FOUNDRY_ENDPOINT=
WORKERS_CONFIDENCE_ROUTING_THRESHOLD=0.7

# ---- Shared Azure (used when wiring real services; offline defaults work without them) ----
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large
