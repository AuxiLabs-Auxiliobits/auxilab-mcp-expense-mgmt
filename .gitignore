# IaC / Bicep
*.azcli
.azure/
bicep/cache/
*.bicepparam.local

# Secrets / local
*.pem
*.key
local.settings.json
appsettings.*.local.json

# Local SQLite databases (dev / smoke runs) + WAL journal files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite
*.sqlite3

# Offline upload fallback stores (receipts / policy docs written when no Azure storage)
receipt_uploads/
policy_uploads/
stitch_mcp_server_frontend (1)
postman
docs

# Dev server runtime files (PID lists, captured stdout/stderr logs)
.dev-pids.txt
*.out.log
*.err.log

# Office/LibreOffice lock files
~$*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# SQLite sidecar files (WAL/SHM/journal) — never commit these; they corrupt across machines
*.db-wal
*.db-shm
*.db-journal
*.db-*

# Local DB backups (never commit)
_db_backup/
*.db.bak*
api/config
db_snapshots
docs
policy_docs
postman
set-azure-env.ps1
