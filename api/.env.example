# Copy to .env for local dev. In Azure these come from Key Vault via app settings.
APP_ENVIRONMENT=dev

# --- Auth: one switch selects the identity model (ADR-001) ---
#   db    → local email/password (DbAuthProvider, HS256)
#   entra → Microsoft Entra ID (preset of the generic OIDC provider)
#   oidc  → any standard OIDC IdP (Entra/Google/Okta/Auth0/Ping/Keycloak)
APP_AUTH_PROVIDER=db
APP_JWT_SECRET=dev-only-change-me
APP_JWT_ALGORITHM=HS256
APP_JWT_TTL_SECONDS=28800

# Microsoft Entra (entra mode) — issuer is derived from the tenant id.
APP_ENTRA_TENANT_ID=
APP_ENTRA_AUDIENCE=                  # the API/app client id the token is minted for
APP_ENTRA_JWKS_URL=                  # optional; derived from tenant if blank

# Generic OIDC (oidc mode) — works for Keycloak/Okta/Auth0/Ping/Google/Entra.
APP_OIDC_ISSUER=                     # e.g. http://localhost:8080/realms/auxilab
APP_OIDC_AUDIENCE=                   # e.g. expense-web
APP_OIDC_JWKS_URL=                   # e.g. http://localhost:8080/realms/auxilab/protocol/openid-connect/certs
APP_OIDC_ALGORITHMS=RS256
APP_OIDC_SUBJECT_CLAIM=sub           # Entra: oid · Keycloak/most: sub
APP_OIDC_EMAIL_CLAIM=email
APP_OIDC_ROLES_CLAIM=roles           # IdP app-roles land here
APP_OIDC_GROUPS_CLAIM=groups
# Map IdP app-role / group value → app role (JSON). DB role still wins for existing users.
APP_OIDC_ROLE_MAP={"Finance Approvers":"finance","Super Admin":"admin"}
# JIT: when a federated user has no DB account.
APP_OIDC_AUTO_PROVISION=false        # false → deny w/ admin-approval message (safest)
APP_OIDC_DEFAULT_ROLE=employee
APP_OIDC_DEFAULT_AGENCY_ID=          # required (and must exist) if auto-provision is true

# --- Email / local password reset ---
APP_EMAIL_BACKEND=console            # console (dev, logs the link) | smtp (staging/prod)
APP_EMAIL_FROM=no-reply@auxilab.local
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_USE_TLS=true
APP_APP_BASE_URL=http://localhost:3000   # base for the emailed reset link
APP_RESET_TOKEN_TTL_MINUTES=30
APP_PASSWORD_MIN_LENGTH=10

# --- Data ---
# SQLite by default (zero infra). Point at Postgres Flexible Server in any real env:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/expense?sslmode=require
APP_DATABASE_URL=sqlite:///./expense.db
APP_DB_ECHO=false
APP_SEED_DEMO_DATA=true        # seed agencies/users on startup (dev only)

# --- Azure (optional; used when wiring the real engine/workers) ---
# Azure AI Foundry (chat) — set the endpoint to GENERATE answers via Foundry (else offline composer).
APP_FOUNDRY_ENDPOINT=
APP_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o
APP_FOUNDRY_API_KEY=                 # prefer Managed Identity; key only for local dev
# Azure AI Search — set the endpoint to RETRIEVE each agency's indexed policy (Policy Assistant RAG).
# Without this, retrieval falls back to the agency's uploaded policy doc + the baseline ruleset.
APP_SEARCH_ENDPOINT=
APP_SEARCH_INDEX_NAME=agency-policies
APP_SEARCH_API_KEY=                  # prefer Managed Identity; key only for local dev
APP_SEARCH_SEMANTIC_CONFIG=default   # must match the index's semantic configuration name
APP_STORAGE_ACCOUNT_URL=
APP_SERVICEBUS_NAMESPACE=
# Azure AI Document Intelligence (prebuilt-receipt) — set to OCR receipts at intake reconciliation.
# Without this, reconciliation parses text receipts only (binary files → routed to Finance).
APP_DOC_INTEL_ENDPOINT=
APP_DOC_INTEL_API_KEY=                # prefer Managed Identity; key only for local dev
# Malware scan (Defender for Storage). true → a receipt with no scan verdict fails closed at
# intake. Offline (file:// blobs / no storage account) the scan is a no-op.
APP_REQUIRE_VIRUS_SCAN=true

# --- CORS ---
# Comma-separated list of browser origins allowed to call this API.
APP_CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Rate limiting ---
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH=10/minute        # per-IP cap on login/token attempts
APP_RATE_LIMIT_FORGOT=5/minute       # per-IP cap on forgot-password

# --- SLA / aging escalation (hours a sheet may wait in a review queue) ---
APP_ESCALATION_WARNING_HOURS=48      # aging warning at 2 days
APP_ESCALATION_CRITICAL_HOURS=120    # escalation at 5 days
