# Copy to .env for local dev. In Azure these come from Key Vault via app settings.
APP_AUTH_PROVIDER=db          # db (now) | entra (later) — the only switch needed

# DbAuthProvider (db mode)
APP_JWT_SECRET=dev-only-change-me
APP_JWT_ALGORITHM=HS256
APP_JWT_TTL_SECONDS=3600

# EntraAuthProvider (entra mode) — fill when migrating
APP_ENTRA_TENANT_ID=
APP_ENTRA_AUDIENCE=
APP_ENTRA_JWKS_URL=

APP_DATABASE_URL=postgresql://localhost:5432/expense
