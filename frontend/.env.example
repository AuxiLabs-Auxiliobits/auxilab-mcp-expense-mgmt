# REFERENCE SCAFFOLD ONLY — copy to .env.local and fill in. Do NOT commit real secrets.

# ---- NextAuth / Auth.js ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-32-byte-secret

# ---- Microsoft Entra External ID (Azure AD provider) ----
# App registration in your Entra External ID tenant. Tokens carry role + agency claims (SCOPING §3).
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=replace-me
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# Optional: explicit issuer / authority (CIAM user-flow authority for External ID)
# AZURE_AD_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0

# ---- Backend (FastAPI) ----
# The portal calls the FastAPI API over REST/HTTPS; RBAC + agency scope are enforced server-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
