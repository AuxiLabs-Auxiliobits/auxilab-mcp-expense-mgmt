# ── Auth.js / NextAuth ───────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Backend login API for the email/password (Credentials) flow.
# POST { email, password } → { access_token }; profile then read from /auth/me.
# Demo users (password `demo`): employee@demo.local · manager@demo.local ·
# finance@demo.local · admin@demo.local. Blank → offline demo accounts.
AUTH_LOGIN_URL=http://localhost:8000/auth/login

# ── SSO ──────────────────────────────────────────────────────────────────────
# The login UI shows the "Continue with…" button automatically when the backend's
# /auth/login-methods reports sso=true (APP_AUTH_PROVIDER=entra|oidc). This var
# only chooses WHICH next-auth provider that button drives.
#   microsoft-entra-id (default) | keycloak
NEXT_PUBLIC_SSO_PROVIDER=microsoft-entra-id

# Microsoft Entra ID (production SSO). Register the three below to enable the provider.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Keycloak — local OIDC stand-in for Entra (see infra/keycloak). Enable by setting both.
AUTH_KEYCLOAK_ID=expense-web
AUTH_KEYCLOAK_SECRET=expense-web-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/auxilab

# Silent refresh / token rotation — the active IdP's token endpoint + client creds.
#   Keycloak: http://localhost:8080/realms/auxilab/protocol/openid-connect/token
#   Entra:    https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# ── Backend API ──────────────────────────────────────────────────────────────
# FastAPI backend base URL. Data routes through src/data/http.ts + src/data/api.ts
# when NEXT_PUBLIC_USE_BACKEND=true (otherwise the in-memory mock is used, so the
# app runs offline by default). The session bearer token is attached automatically.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_BACKEND=true
