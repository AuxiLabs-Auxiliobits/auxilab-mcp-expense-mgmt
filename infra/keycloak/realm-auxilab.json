{
  "realm": "auxilab",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "employee" },
      { "name": "manager" },
      { "name": "finance" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "expense-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "expense-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-expense-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "expense-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "employee@demo.local",
      "email": "employee@demo.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Evan",
      "lastName": "Employee",
      "credentials": [{ "type": "password", "value": "Keycloak1!", "temporary": false }],
      "realmRoles": ["employee", "offline_access"]
    },
    {
      "username": "newhire@partner.local",
      "email": "newhire@partner.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Nadia",
      "lastName": "Newhire",
      "credentials": [{ "type": "password", "value": "Keycloak1!", "temporary": false }],
      "realmRoles": ["manager", "offline_access"]
    }
  ]
}
