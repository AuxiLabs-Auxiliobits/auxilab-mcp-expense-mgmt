# expense_mcp — optional configuration (SCOPING §11, §F).
#
# The server runs FULLY OFFLINE with none of these set: LLM-using tools fall back to
# expense_core's deterministic LocalEchoProvider. These vars only take effect when a
# tool is called with use_llm=true AND both are present, wiring AzureFoundryProvider
# (needs the [azure] extra, which pulls expense-core[azure]).

# Azure AI Foundry chat-completions endpoint, e.g. https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=

# Foundry deployment / model name, e.g. gpt-4o-mini
AZURE_FOUNDRY_DEPLOYMENT=
