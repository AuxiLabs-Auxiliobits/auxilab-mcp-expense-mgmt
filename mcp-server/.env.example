# expense_mcp — configuration

# ── Business tools → FastAPI backend ─────────────────────────────────────────
# The authenticated business tools (expenses, approvals, finance, dashboard, users,
# receipts, assistant) call the platform's FastAPI backend. Point at it here.
EXPENSE_API_URL=http://localhost:8000
EXPENSE_API_TIMEOUT=30
EXPENSE_API_MAX_RETRIES=2          # retries for transient failures on idempotent GETs only

# Bootstrap bearer token: every tool acts as THIS user and the API enforces their
# role/agency permissions. Leave blank and use the `login` tool instead. Prefer setting
# this in the MCP host config (e.g. Claude Desktop "env") rather than committing it.
EXPENSE_API_TOKEN=

# ── Engine tools → Azure AI Foundry (optional) ───────────────────────────────
# The five stateless engine tools run fully offline (LocalEchoProvider). These only take
# effect when a tool is called with use_llm=true AND both are present (needs the [azure]
# extra). The backend's own Foundry wiring is configured separately in the api package.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_DEPLOYMENT=
