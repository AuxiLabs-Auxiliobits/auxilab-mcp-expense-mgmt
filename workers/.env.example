# expense-workers configuration (env prefix WORKERS_).
# All values are offline-safe placeholders: leaving the Azure endpoints empty selects the
# in-memory fallbacks (InMemoryRetriever, NoopShield, LocalEchoProvider) so `python -m
# workers demo` and the tests run with no Azure. Populate these + install the [azure] extra
# to wire real services.

# --- Azure Service Bus (finance-approval + ingestion queues, SCOPING §11, §14) ---
# Set EITHER a connection string OR the fully-qualified namespace (preferred: the worker's
# Managed Identity holds the Service Bus Data Receiver role, no secret needed).
WORKERS_SERVICE_BUS_CONNECTION_STRING=
# e.g. expmgmt-dev-bus.servicebus.windows.net
WORKERS_SERVICE_BUS_NAMESPACE=
WORKERS_FINANCE_QUEUE_NAME=finance-approval
WORKERS_INGESTION_QUEUE_NAME=document-ingestion
WORKERS_MAX_DELIVERY_COUNT=5
WORKERS_RECEIVE_MAX_WAIT_SECONDS=30

# --- Azure AI Search (per-agency RAG index, SCOPING §7) ---
WORKERS_SEARCH_ENDPOINT=
WORKERS_SEARCH_INDEX_NAME=agency-policies
# Prefer Managed Identity in production; key is for local dev only.
WORKERS_SEARCH_API_KEY=

# --- Azure AI Foundry (model-agnostic LLM gateway, SCOPING §11) ---
WORKERS_FOUNDRY_ENDPOINT=
WORKERS_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# --- Document ingestion: Blob + Document Intelligence + Defender scan (SCOPING §7) ---
# Empty storage account → offline: read file:// blob URIs locally and skip the virus scan.
WORKERS_STORAGE_ACCOUNT_URL=
WORKERS_DOC_INTEL_ENDPOINT=
# Fail-closed if Defender for Storage's scan-result tag is absent on the blob. Only set to
# false for environments where Defender for Storage malware scanning is not enabled.
WORKERS_REQUIRE_VIRUS_SCAN=true

# --- Ingestion / finance-decision → API callback (SCOPING §6.3, §7) ---
# Empty base URL → no callback (offline). agent_token is the AGENT service-principal bearer
# used for POST /finance/policies/{id}/indexed and POST /finance/sheets/{id}/llm-decision.
WORKERS_API_BASE_URL=
WORKERS_AGENT_TOKEN=

# --- Azure AI Content Safety / Prompt Shields (SCOPING §7, §9.2) ---
WORKERS_CONTENT_SAFETY_ENDPOINT=
WORKERS_CONTENT_SAFETY_API_KEY=

# --- LLM guardrails (SCOPING §6.4, §9.2, §8) ---
WORKERS_CONFIDENCE_ROUTING_THRESHOLD=0.7
WORKERS_PER_SHEET_TOKEN_BUDGET=20000
WORKERS_LLM_TEMPERATURE=0.0

# --- Container runtime ---
# Which consumer the container launches: finance | ingestion (read by `python -m workers`).
# NB: this is NOT WORKERS_-prefixed; it is read directly from the environment.
WORKER_CONSUMER=finance
